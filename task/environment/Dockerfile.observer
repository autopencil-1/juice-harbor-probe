FROM python@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6
COPY observer.py /observer.py
COPY scoring-manifest.json /opt/benchmark/scoring-manifest.json
RUN ["python", "-c", "import os; os.makedirs('/evidence', exist_ok=True); os.chown('/evidence', 65532, 65532)"]
USER 65532:65532
CMD ["python", "/observer.py", "baseline"]
