FROM nginx@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
RUN sed -i -e 's@^[[:space:]]*pid[[:space:]].*;@pid /tmp/nginx.pid;@' -e '/^user[[:space:]]/d' /etc/nginx/nginx.conf \
    && chown -R 101:101 /etc/nginx/conf.d /var/cache/nginx
COPY --chown=101:101 gateway-closed.conf /etc/nginx/conf.d/default.conf
COPY gateway-open.conf /opt/gateway/open.conf
USER 101:101
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
